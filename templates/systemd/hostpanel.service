# Generated by HostPanel installer.
[Unit]
Description=HostPanel control panel
After=network-online.target caddy.service pdns.service stalwart.service mariadb.service
Wants=network-online.target caddy.service

[Service]
Type=simple
EnvironmentFile=/etc/hostpanel/hostpanel.env
Environment=NODE_ENV=production
WorkingDirectory=/opt/hostpanel/panel/api
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/index.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
